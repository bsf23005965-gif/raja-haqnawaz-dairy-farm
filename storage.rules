rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Animal Photos & Farm Branding: Public read, Admin write
    match /animals/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && 
        (request.auth.token.role == 'Admin' || request.auth.token.email == 'admin@rajahaqnawazdairy.com');
    }

    match /branding/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && 
        (request.auth.token.role == 'Admin' || request.auth.token.email == 'admin@rajahaqnawazdairy.com');
    }

    // User Profile Images: Owner write
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
